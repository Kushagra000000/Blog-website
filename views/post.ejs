<div class="post-header">
  <h1><%= data.title %></h1>
  <div class="post-meta">
    <%= new Date(data.createdAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }) %>
    &nbsp;·&nbsp; <%= data.views || 0 %> views
  </div>
</div>

<div class="post-body"><%- data.bodyHtml %></div>

<% if (data.images && data.images.length) { %>
  <div class="post-images">
    <% data.images.forEach(img => { %>
      <img src="<%= img %>" alt="">
    <% }) %>
  </div>
<% } %>

<section class="comments-section" id="comments">
  <h2>Comments</h2>

  <% if ((comments || []).length === 0) { %>
    <p class="text-muted" style="font-size:0.9rem;">No comments yet.</p>
  <% } else { %>
    <ul class="comment-list">
      <% comments.forEach(c => { %>
        <li class="comment-item">
          <div class="comment-meta">
            <strong><%= c.username %></strong>
            &nbsp;·&nbsp;
            <%= new Date(c.createdAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %>
          </div>
          <div class="comment-body"><%= c.body %></div>
        </li>
      <% }) %>
    </ul>
  <% } %>

  <div class="comment-form">
    <h3>Leave a comment</h3>
    <form action="/post/<%= data._id %>/comment" method="POST">
      <label>Name</label>
      <input name="username" required>
      <label>Email <span style="font-weight:400;text-transform:none;letter-spacing:0;">(not shown publicly)</span></label>
      <input type="email" name="email" required>
      <label>Comment</label>
      <textarea name="body" rows="4" required></textarea>
      <button class="btn" type="submit">Post comment</button>
    </form>
  </div>
</section>