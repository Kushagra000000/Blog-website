<div class="admin-header">
  <h1>Dashboard</h1>
</div>
<div class="admin-nav">
  <a class="btn" href="/admin/new">New post</a>
  <a class="btn btn-secondary" href="/admin/projects">Projects</a>
  <a class="btn btn-secondary" href="/admin/now">Now page</a>
  <a class="btn btn-secondary" href="/admin/visitors">Visitors</a>
  <a class="btn btn-secondary" href="/admin/logout">Logout</a>
</div>

<h2 style="font-size:1rem; margin-bottom:1rem;">Posts</h2>
<ul class="admin-post-list">
<% (posts || []).forEach(p => { %>
  <li>
    <div class="admin-post-info">
      <strong><%= p.title %></strong>
      <small><%= new Date(p.createdAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %></small>
    </div>
    <div class="admin-actions">
      <a class="btn btn-secondary" href="/post/<%= p._id %>">View</a>
      <a class="btn btn-secondary" href="/admin/visitors?postId=<%= p._id %>">Visitors</a>
      <a class="btn btn-secondary" href="/admin/comments/<%= p._id %>">Comments</a>
    </div>
  </li>
<% }) %>
</ul>