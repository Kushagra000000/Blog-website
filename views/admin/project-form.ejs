<div class="admin-header">
  <h1><%= project ? 'Edit Project' : 'New Project' %></h1>
</div>
<div class="admin-nav">
  <a class="btn btn-secondary" href="/admin/projects">← Projects</a>
</div>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<form action="<%= project ? '/admin/projects/edit/' + project._id : '/admin/projects/new' %>" method="POST">
  <label>Title</label>
  <input name="title" required value="<%= project ? project.title : '' %>">

  <label>Description</label>
  <textarea name="description" rows="3" required><%= project ? project.description : '' %></textarea>

  <label>URL <span style="font-weight:400;text-transform:none;letter-spacing:0;">(GitHub or live link, optional)</span></label>
  <input type="url" name="url" value="<%= project ? (project.url || '') : '' %>" placeholder="https://...">

  <label>Status</label>
  <select name="status">
    <option value="active"     <%= project && project.status === 'active'     ? 'selected' : '' %>>Active</option>
    <option value="completed"  <%= project && project.status === 'completed'  ? 'selected' : '' %>>Completed</option>
    <option value="paused"     <%= project && project.status === 'paused'     ? 'selected' : '' %>>Paused</option>
  </select>

  <button class="btn" type="submit"><%= project ? 'Save changes' : 'Add project' %></button>
</form>