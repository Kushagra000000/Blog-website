<div class="admin-header">
  <h1>New Post</h1>
</div>
<div class="admin-nav">
  <a class="btn btn-secondary" href="/admin">← Dashboard</a>
</div>
<% if (error) { %><p class="error-msg"><%= error %></p><% } %>

<form action="/admin/new" method="POST" enctype="multipart/form-data">
  <label>Title</label>
  <input name="title" required>

  <label>Body <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:0.85rem;">(Markdown supported)</span></label>
  <textarea name="body" rows="14" placeholder="# Heading&#10;&#10;Write in Markdown..."></textarea>

  <label>Images <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:0.85rem;">(optional, up to 6)</span></label>
  <input type="file" name="images" multiple accept="image/*" style="margin-bottom:1rem; font-size:0.875rem;">

  <button class="btn" type="submit">Publish</button>
</form>