<div class="admin-header">
  <h1>Comments</h1>
</div>
<div class="admin-nav">
  <a class="btn btn-secondary" href="/admin">← Dashboard</a>
  <a class="btn btn-secondary" href="/admin/visitors?postId=<%= postId %>">View visitors</a>
</div>
<p class="text-muted" style="font-size:0.875rem; margin-bottom:1.5rem;">Post: <%= postId %></p>

<table class="admin-table">
  <thead>
    <tr>
      <th>When</th><th>Name</th><th>Email</th><th>Comment</th><th>Action</th>
    </tr>
  </thead>
  <tbody>
  <% (comments || []).forEach(c => { %>
    <tr>
      <td><%= new Date(c.createdAt).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' }) %></td>
      <td><%= c.username %></td>
      <td><%= c.email %></td>
      <td><%= c.body %></td>
      <td>
        <form method="POST" action="/admin/comments/delete/<%= c._id %>" onsubmit="return confirm('Delete?');">
          <button class="btn btn-delete" type="submit">Delete</button>
        </form>
      </td>
    </tr>
  <% }) %>
  </tbody>
</table>