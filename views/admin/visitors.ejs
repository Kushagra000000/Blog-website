<div class="admin-header">
  <h1>Visitors</h1>
</div>
<div class="admin-nav">
  <a class="btn btn-secondary" href="/admin">← Dashboard</a>
</div>

<table class="admin-table">
  <thead>
    <tr><th>Post ID</th><th>IP</th><th>User Agent</th><th>When</th></tr>
  </thead>
  <tbody>
  <% (visits || []).forEach(v => { %>
    <tr>
      <td><%= v.postId %></td>
      <td><%= v.ip %></td>
      <td style="font-size:0.8rem; color:var(--muted);"><%= v.ua %></td>
      <td><%= new Date(v.createdAt).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' }) %></td>
    </tr>
  <% }) %>
  </tbody>
</table>