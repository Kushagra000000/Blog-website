<footer class="footer">
  <span>&copy; <%= new Date().getFullYear() %> <%= site.name %></span>
  <div class="footer__links">
    <% if (site.socials.github)    { %><a href="<%= site.socials.github %>"    target="_blank" rel="noreferrer">GitHub</a><% } %>
    <% if (site.socials.linkedin)  { %><a href="<%= site.socials.linkedin %>"  target="_blank" rel="noreferrer">LinkedIn</a><% } %>
    <% if (site.socials.instagram) { %><a href="<%= site.socials.instagram %>" target="_blank" rel="noreferrer">Instagram</a><% } %>
    <% if (site.email)             { %><a href="mailto:<%= site.email %>">Email</a><% } %>
  </div>
</footer>