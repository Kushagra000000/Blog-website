<div class="intro">
  <p><%= site.tagline %></p>
</div>

<ul class="post-list">
<% (data || []).forEach(post => { %>
  <li>
    <a href="/post/<%= post._id %>">
      <span class="post-title"><%= post.title %></span>
      <span class="post-date"><%= new Date(post.createdAt).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
    </a>
  </li>
<% }) %>
</ul>