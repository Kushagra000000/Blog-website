<h1 class="page-title">Now</h1>
<p class="text-muted" style="font-size:0.875rem; margin-bottom:2rem;">What I'm up to at the moment... Updated occasionally.</p>

<% if (data.studying) { %>
  <div class="now-section"><h2>Studying</h2><p><%= data.studying %></p></div>
<% } %>
<% if (data.building) { %>
  <div class="now-section"><h2>Building</h2><p><%= data.building %></p></div>
<% } %>
<% if (data.reading) { %>
  <div class="now-section"><h2>Reading</h2><p><%= data.reading %></p></div>
<% } %>
<% if (data.other) { %>
  <div class="now-section"><h2>Other</h2><p><%= data.other %></p></div>
<% } %>
<% if (!data.studying && !data.building && !data.reading && !data.other) { %>
  <p class="text-muted">Nothing here yet.</p>
<% } %>

<p class="now-updated"><% if (data.lastUpdated) { %>Last updated: <%= data.lastUpdated %><% } %></p>